<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Active le vrai rendu par écran (per-monitor DPI) de WPF 4.8 : sans cet interrupteur,
         Windows étire la fenêtre en bitmap sur les écrans à 125/150 % → texte baveux. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
